{
  "name": "moduleforge-reference-modules",
  "private": true,
  "type": "module",
  "description": "Reference ModuleForge modules (payment-method, invoice, notification-adapter) plus a demo host.",
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test \"*/test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "demo": "node --disable-warning=ExperimentalWarning --import tsx _host/demo.ts",
    "zip": "node --import tsx scripts/zip-modules.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
