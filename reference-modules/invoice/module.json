{
  "id": "invoice",
  "name": "Invoices",
  "version": "1.0.0",
  "description": "Create, list and track invoices with line items and totals (draft/sent/paid/void). Marks invoices paid when a payment.received event arrives.",
  "type": "fullstack",
  "category": "Accounting",
  "dependsOn": [{ "id": "payment-method", "versionRange": "^1.0.0", "optional": true }],
  "provides": {
    "apiPrefix": "/api/invoices",
    "routes": [
      "GET /api/invoices",
      "POST /api/invoices",
      "GET /api/invoices/:id",
      "POST /api/invoices/:id/send",
      "POST /api/invoices/:id/void"
    ],
    "uiExports": ["Invoices"]
  },
  "requires": {
    "env": [],
    "database": { "tables": ["inv_invoices", "inv_items"], "prefix": "inv_" },
    "hostServices": ["auth.currentUser", "db"]
  },
  "events": {
    "publishes": ["invoice.created", "invoice.paid"],
    "consumes": ["payment.received"]
  },
  "permissions": ["invoice.invoice.read", "invoice.invoice.create", "invoice.invoice.send", "invoice.invoice.void"],
  "runtime": { "frontendCommand": null, "backendCommand": null, "ports": [] },
  "compatibility": { "moduleforge": ">=1.0.0" }
}
