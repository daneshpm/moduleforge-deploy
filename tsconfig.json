{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "outDir": ".vercel/output"
  },
  "include": [
    "api/**/*",
    "server/src/**/*"
  ],
  "exclude": [
    "server/src/__tests__/**",
    "server/src/test_*.ts"
  ]
}
