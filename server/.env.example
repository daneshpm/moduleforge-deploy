# Server environment (copy to server/.env for local dev, set in Vercel for deploys). No real values here.
NODE_ENV=development
DATABASE_URL="file:./dev.db"
# Firebase project id(s) used to verify ID tokens; comma-separated list allowed (e.g. old,new).
FIREBASE_PROJECT_ID=
# Leave unset in production (enforced by default). ENFORCE_AUTH=true to enforce locally.
# ENFORCE_AUTH=
# Extra allowed browser origins (comma-separated). Same-origin requests are always allowed.
ALLOWED_ORIGINS=
GITHUB_WEBHOOK_SECRET=
