# Client build variables. Vite only exposes VITE_-prefixed variables to the browser.
# Set these in Vercel (Production + Preview). Without them src/firebase.ts falls back to project "modulefodge".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# VITE_API_URL=
